*.class
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Ensure build wrappers are not accidentally ignored
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Build Tools & Output Directories
# ==========================================
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ==========================================
# IDEs & Code Editors
# ==========================================
